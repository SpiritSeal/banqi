# Banqi relay server configuration. Copy to .env for local dev; set as env vars
# (or Cloud Run secrets) in production.

# Where to bind.
PORT=8080
PUBLIC_URL=http://localhost:8080

# Long random string used to sign session cookies. Treat it like a database
# password — rotating it logs everyone out but does not invalidate game state.
SERVER_SECRET=replace-me-with-a-long-random-string

# PostgreSQL connection string.
# Local dev:  postgresql://localhost/banqi
# Neon:       postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/banqi?sslmode=require
# Supabase:   postgresql://postgres:pass@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://localhost/banqi

# OAuth credentials. Both providers are optional — at least one must be set
# for online play. If you want anonymous OAuth-free dev, set AUTH_DEV=1.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 in development to enable an /auth/dev?name=Alice route that creates
# a user without going through OAuth. NEVER enable in production. AUTH_DEV=1
# also bypasses the SERVER_SECRET-must-be-set boot check (so the placeholder
# above is accepted) — handy for local dev, never appropriate in production.
AUTH_DEV=0

# Set to 1 (or your reverse-proxy hop count) when running behind a trusted
# reverse proxy that terminates TLS and forwards X-Forwarded-* headers — Cloud
# Run, nginx, Cloudflare, etc. Leave empty otherwise: trusting these headers
# without a proxy lets any client spoof their source IP and bypass per-IP
# rate limits. Accepts Express's full grammar (numeric hop count, "loopback",
# IP ranges, etc.).
TRUST_PROXY=

# Web Push (VAPID) keys. Used to send "your turn" notifications to players
# whose device is not currently connected to the WebSocket. Generate once with:
#   npx web-push generate-vapid-keys
# Treat the private key like a database password. If unset, push notifications
# are simply disabled (in-page sound + title-bar alerts still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact identifier the push service can reach you at (mailto: or https URL).
VAPID_SUBJECT=mailto:admin@example.com
