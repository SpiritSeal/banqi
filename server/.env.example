# Banqi relay server configuration. Copy to .env for local dev; set as env vars
# (or fly secrets) in production.

# Where to bind.
PORT=8080
PUBLIC_URL=http://localhost:8080

# Long random string. Used to (a) sign session cookies, and (b) derive each
# user's Ed25519 identity seed via HKDF. CHANGING THIS INVALIDATES ALL
# RECONNECTABILITY: every user gets a fresh keypair, and all in-flight games
# become unreconcilable. Treat it like a master DB key.
SERVER_SECRET=replace-me-with-a-long-random-string

# Where SQLite lives. Use a persistent volume in production.
DATABASE_FILE=./banqi.db

# OAuth credentials. Both providers are optional — at least one must be set
# for online play. If you want anonymous OAuth-free dev, set AUTH_DEV=1.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 in development to enable an /auth/dev?name=Alice route that creates
# a user without going through OAuth. NEVER enable in production.
AUTH_DEV=0
