{
  "name": "banqi-relay",
  "version": "0.1.0",
  "description": "Federated relay server for banqi-p2p: OAuth, correspondence games, Elo leaderboard",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.mjs",
    "dev":   "node --watch src/index.mjs",
    "test":  "node --test --test-concurrency=1 tests/*.mjs"
  },
  "dependencies": {
    "cookie":                 "^1.0.1",
    "express":                "^4.21.0",
    "express-session":        "^1.18.0",
    "helmet":                 "^8.0.0",
    "passport":               "^0.7.0",
    "passport-github2":       "^0.1.12",
    "passport-google-oauth20":"^2.0.0",
    "pg":                     "^8.13.0",
    "ws":                     "^8.18.0",
    "dotenv":                 "^16.4.5",
    "web-push":               "^3.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
